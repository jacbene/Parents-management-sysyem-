{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist-server",
    "strict": false,
    "noEmitOnError": false,
    "jsx": "react-jsx"
  },
  "include": ["server.ts", "src/**/*.ts", "src/**/*.tsx"]
}
