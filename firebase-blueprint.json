{
  "entities": {
    "student": {
      "title": "Student",
      "description": "A student profile registered under a parent account.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "grade": { "type": "string", "maxLength": 100 },
        "classRoom": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 50 },
        "teacherName": { "type": "string", "maxLength": 200 },
        "teacherEmail": { "type": "string", "maxLength": 200 },
        "dob": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "parentId", "name"]
    },
    "grade": {
      "title": "Grade",
      "description": "An academic performance grade record for a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 100 },
        "examName": { "type": "string", "maxLength": 100 },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "teacherRemarks": { "type": "string", "maxLength": 1000 },
        "date": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "parentId"]
    },
    "attendance": {
      "title": "Attendance",
      "description": "An attendance logging record for a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Present", "Absent", "Late", "Excused"] },
        "remarks": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "studentId", "parentId", "date", "status"]
    },
    "homework": {
      "title": "Homework",
      "description": "A homework assignment assigned to the student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Pending", "Completed", "Overdue"] },
        "grade": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "parentId", "title"]
    },
    "announcement": {
      "title": "Announcement",
      "description": "A broadcast from administrators or teachers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 50 },
        "author": { "type": "string", "maxLength": 200 },
        "pinned": { "type": "boolean" },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "pdfUrl": { "type": "string", "maxLength": 1000 },
        "pdfFileName": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "title"]
    },
    "appointment": {
      "title": "Appointment",
      "description": "A scheduled Parent-Teacher Consultation meeting.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 100 },
        "dateTime": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "studentId", "parentId"]
    },
    "message": {
      "title": "Message",
      "description": "A communication message exchange on the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "senderType": { "type": "string", "maxLength": 50 },
        "content": { "type": "string", "maxLength": 3000 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "teacherName": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "parentId"]
    },
    "invoice": {
      "title": "Invoice",
      "description": "A school fee billing invoice document or settings ledger.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "paymentDate": { "type": "string", "maxLength": 50 }
      },
      "required": ["id"]
    },
    "establishment": {
      "title": "Establishment",
      "description": "A registered school establishment document.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 50 },
        "logo": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "name"]
    },
    "super_admin": {
      "title": "Super Admin",
      "description": "System administrator account.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "addedBy": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "email"]
    },
    "lesson": {
      "title": "Lesson",
      "description": "Classroom weekly lesson details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 128 },
        "classRoom": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "date": { "type": "string", "maxLength": 50 },
        "teacherName": { "type": "string", "maxLength": 200 }
      },
      "required": ["id"]
    },
    "auth_log": {
      "title": "Auth Log",
      "description": "Secure logging of authentication errors and attempts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "errorCode": { "type": "string", "maxLength": 100 },
        "errorMessage": { "type": "string", "maxLength": 1000 },
        "action": { "type": "string", "maxLength": 100 },
        "component": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "timestamp"]
    },
    "help_request": {
      "title": "Help Request",
      "description": "Help support request sent by users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 3000 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["message"]
    },
    "roadmap_suggestion": {
      "title": "Roadmap Suggestion",
      "description": "Feature suggestions submitted by users.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 }
      },
      "required": ["title"]
    },
    "reading_log": {
      "title": "Reading Log",
      "description": "Library reading logs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "bookTitle": { "type": "string", "maxLength": 200 }
      },
      "required": ["id"]
    },
    "user": {
      "title": "User",
      "description": "User profile document.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 50 }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "students": { "schema": "student", "description": "Collection of student profiles." },
    "grades": { "schema": "grade", "description": "Academic grade history entries." },
    "attendance": { "schema": "attendance", "description": "Attendance history logging." },
    "homeworks": { "schema": "homework", "description": "Assigned homework pieces tracker." },
    "announcements": { "schema": "announcement", "description": "School announcement broadcasts." },
    "appointments": { "schema": "appointment", "description": "Parent-Teacher meeting scheduling data." },
    "messages": { "schema": "message", "description": "Messages historical index." },
    "invoices": { "schema": "invoice", "description": "Tuition fees and billing ledger." },
    "establishments": { "schema": "establishment", "description": "Registered school establishments." },
    "super_admins": { "schema": "super_admin", "description": "Super admin users list." },
    "lessons": { "schema": "lesson", "description": "Weekly classroom lessons." },
    "logs_auth": { "schema": "auth_log", "description": "Authentication audit trail." },
    "help_requests": { "schema": "help_request", "description": "Helpdesk support tickets." },
    "roadmap_suggestions": { "schema": "roadmap_suggestion", "description": "User feedback and roadmap suggestions." },
    "reading_logs": { "schema": "reading_log", "description": "Library reading tracker." },
    "users": { "schema": "user", "description": "User profile documents." },
    "active_sessions": { "schema": "user", "description": "Active session tokens." },
    "system": { "schema": "user", "description": "System state documents." }
  }
}
