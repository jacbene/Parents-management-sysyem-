# ==========================================
# CONFIGURATION PASMA-SYS
# ==========================================

# 1. URL DU BACKEND (RENDER) - Utilisé par le frontend pour joindre l'API
VITE_API_URL="https://pasma-sys-backend.onrender.com"

# 2. Clé Webhook Campay (pour l'affichage dans le module de paiement)
VITE_CAMPAY_WEBHOOK_KEY=""

# ==========================================
# VARIABLES SERVEUR (À DÉFINIR DANS RENDER)
# ==========================================
NODE_ENV="production"
PORT=10000

# TWILIO (ENVOI DE SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
TWILIO_PHONE_NAME="Pasma SMS Principal"

# GEMINI AI (GÉNÉRATION DE DEVOIRS)
GEMINI_API_KEY=""

# CAMPAY (PAIEMENTS MOBILE MONEY)
CAMPAY_TOKEN=""
CAMPAY_WEBHOOK_KEY=""

# SERVEUR EMAIL SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
