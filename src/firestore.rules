rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == 'jacquesbene301@gmail.com' ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid)) ||
        (request.auth.token.get('email', '') != '' &&
          exists(/databases/$(database)/documents/super_admins/$(request.auth.token.get('email', ''))))
      );
    }

    function isSchoolOwner(schoolId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/establishments/$(schoolId)) &&
        get(/databases/$(database)/documents/establishments/$(schoolId)).data.get('ownerId', '') == request.auth.uid;
    }

    function hasSchoolEmail(establishment, field) {
      return isSignedIn() &&
        request.auth.token.get('email', '') != '' &&
        establishment.get(field, []) is list &&
        establishment.get(field, []).hasAny([request.auth.token.get('email', '')]);
    }

    function isSchoolManagerData(establishment) {
      return isSignedIn() && (
        establishment.get('ownerId', '') == request.auth.uid ||
        (request.auth.token.get('email', '') != '' &&
          (
            establishment.get('directorEmail', '') == request.auth.token.get('email', '') ||
            establishment.get('finManagerEmail', '') == request.auth.token.get('email', '') ||
            establishment.get('pedManagerEmail', '') == request.auth.token.get('email', '') ||
            hasSchoolEmail(establishment, 'managerEmails')
          ))
      );
    }

    function isSchoolManager(schoolId) {
      return exists(/databases/$(database)/documents/establishments/$(schoolId)) &&
        isSchoolManagerData(get(/databases/$(database)/documents/establishments/$(schoolId)).data);
    }

    function isSchoolTeacher(schoolId) {
      return exists(/databases/$(database)/documents/establishments/$(schoolId)) &&
        hasSchoolEmail(
          get(/databases/$(database)/documents/establishments/$(schoolId)).data,
          'teacherEmails'
        );
    }

    function isSchoolParent(schoolId) {
      return exists(/databases/$(database)/documents/establishments/$(schoolId)) &&
        hasSchoolEmail(
          get(/databases/$(database)/documents/establishments/$(schoolId)).data,
          'parentEmails'
        );
    }

    function canAccessSchoolData(schoolId) {
      return isSuperAdmin() || isSchoolManager(schoolId) || isSchoolTeacher(schoolId) || isSchoolParent(schoolId);
    }

    function canAccessParentRecord(data) {
      return isSuperAdmin() ||
        (data.keys().hasAny(['parentId']) && canAccessSchoolData(data.parentId));
    }

    function canAccessSchoolRecord(data) {
      return isSuperAdmin() ||
        (data.keys().hasAny(['schoolId']) && canAccessSchoolData(data.schoolId));
    }

    function canAccessManagerRecord(data) {
      return isSuperAdmin() ||
        (data.keys().hasAny(['parentId']) && isSchoolManager(data.parentId));
    }

    function hasPrivilegedUserFields(data) {
      return data.keys().hasAny([
        'role', 'roles', 'permissions', 'admin', 'isAdmin',
        'superAdmin', 'isSuperAdmin', 'schoolId', 'establishmentId', 'ownerId'
      ]);
    }

    match /super_admins/{adminId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSuperAdmin() ||
        (isSignedIn() &&
          (userId == request.auth.uid || userId == request.auth.token.get('email', '')));
      allow create: if isSuperAdmin() ||
        (isSignedIn() &&
          (userId == request.auth.uid || userId == request.auth.token.get('email', '')) &&
          !hasPrivilegedUserFields(request.resource.data));
      allow update: if isSuperAdmin() ||
        (isSignedIn() &&
          (userId == request.auth.uid || userId == request.auth.token.get('email', '')) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'roles', 'permissions', 'admin', 'isAdmin',
            'superAdmin', 'isSuperAdmin', 'schoolId', 'establishmentId', 'ownerId'
          ]));
      allow delete: if isSuperAdmin();
    }

    match /active_sessions/{sessionId} {
      allow read, write: if isSuperAdmin() ||
        (isSignedIn() && sessionId == request.auth.uid);
    }

    match /establishments/{schoolId} {
      allow read: if isSuperAdmin() ||
        isSchoolManagerData(resource.data);
      allow create: if isSuperAdmin() ||
        (isSignedIn() &&
          request.resource.data.ownerId == request.auth.uid &&
          (!request.resource.data.keys().hasAny(['portalFeesPaid']) ||
            request.resource.data.portalFeesPaid == 0) &&
          !request.resource.data.keys().hasAny(['lastPortalPaymentDate']));
      allow update: if isSuperAdmin() ||
        ((isSchoolOwner(schoolId) || isSchoolManagerData(resource.data)) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'portalFeesPaid', 'lastPortalPaymentDate'
          ]) &&
          (isSchoolOwner(schoolId) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'directorEmail', 'managerEmails', 'teacherEmails', 'parentEmails',
              'cotisationAmount', 'financialGoal', 'lastManagerDeviceId'
            ])));
      allow delete: if isSuperAdmin();
    }

    match /students/{recordId} {
      allow read: if canAccessParentRecord(resource.data);
      allow create: if canAccessParentRecord(request.resource.data);
      allow update: if canAccessParentRecord(resource.data) &&
        (isSuperAdmin() || request.resource.data.parentId == resource.data.parentId);
      allow delete: if canAccessParentRecord(resource.data);
    }

    match /grades/{recordId} {
      allow read: if canAccessParentRecord(resource.data);
      allow create: if canAccessParentRecord(request.resource.data);
      allow update: if canAccessParentRecord(resource.data) &&
        (isSuperAdmin() || request.resource.data.parentId == resource.data.parentId);
      allow delete: if canAccessParentRecord(resource.data);
    }

    match /attendance/{recordId} {
      allow read: if canAccessParentRecord(resource.data);
      allow create: if canAccessParentRecord(request.resource.data);
      allow update: if canAccessParentRecord(resource.data) &&
        (isSuperAdmin() || request.resource.data.parentId == resource.data.parentId);
      allow delete: if canAccessParentRecord(resource.data);
    }

    match /homeworks/{recordId} {
      allow read: if canAccessParentRecord(resource.data);
      allow create: if canAccessParentRecord(request.resource.data);
      allow update: if canAccessParentRecord(resource.data) &&
        (isSuperAdmin() || request.resource.data.parentId == resource.data.parentId);
      allow delete: if canAccessParentRecord(resource.data);
    }

    match /lessons/{recordId} {
      allow read: if canAccessParentRecord(resource.data);
      allow create: if canAccessParentRecord(request.resource.data);
      allow update: if canAccessParentRecord(resource.data) &&
        (isSuperAdmin() || request.resource.data.parentId == resource.data.parentId);
      allow delete: if canAccessParentRecord(resource.data);
    }

    match /reading_logs/{recordId} {
      allow read, write: if isSuperAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /academic_calendar/{recordId} {
      allow read: if canAccessSchoolRecord(resource.data);
      allow create: if canAccessSchoolRecord(request.resource.data);
      allow update: if canAccessSchoolRecord(resource.data) &&
        (isSuperAdmin() || request.resource.data.schoolId == resource.data.schoolId);
      allow delete: if canAccessSchoolRecord(resource.data);
    }

    match /appointments/{recordId} {
      allow read: if canAccessParentRecord(resource.data);
      allow create: if canAccessParentRecord(request.resource.data);
      allow update: if canAccessParentRecord(resource.data) &&
        (isSuperAdmin() || request.resource.data.parentId == resource.data.parentId);
      allow delete: if canAccessParentRecord(resource.data);
    }

    match /messages/{recordId} {
      allow read: if canAccessParentRecord(resource.data);
      allow create: if canAccessParentRecord(request.resource.data);
      allow update: if canAccessParentRecord(resource.data) &&
        (isSuperAdmin() || request.resource.data.parentId == resource.data.parentId);
      allow delete: if canAccessParentRecord(resource.data);
    }

    match /invoices/{recordId} {
      allow read: if canAccessManagerRecord(resource.data) ||
        (isSignedIn() && request.auth.token.get('email', '') != '' &&
          resource.data.get('email', '') == request.auth.token.get('email', ''));
      allow create: if canAccessManagerRecord(request.resource.data);
      allow update: if canAccessManagerRecord(resource.data) &&
        (isSuperAdmin() || request.resource.data.parentId == resource.data.parentId);
      allow delete: if canAccessManagerRecord(resource.data);
    }

    match /help_requests/{recordId} {
      allow read, write: if isSuperAdmin();
    }

    match /roadmap_suggestions/{recordId} {
      allow read, write: if isSuperAdmin();
    }

    match /logs_auth/{recordId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSuperAdmin();
    }

    match /system/{recordId} {
      allow read, write: if isSuperAdmin();
    }

    match /portal_payment_intents/{recordId} {
      allow read, write: if false;
    }

    match /tuition_payment_intents/{recordId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
