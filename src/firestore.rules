rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function isSelfUser(email) {
      return signedIn() && request.auth.token.email != null && request.auth.token.email == email;
    }

    function isSchoolAdmin() {
      return emailVerified() && (
        exists(/databases/$(database)/documents/super_admins/$(request.auth.token.email)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ['admin', 'manager', 'super_admin', 'director', 'intendant'])
      );
    }

    function isOwnerOrParent() {
      return emailVerified() && resource.data.parentId == request.auth.uid;
    }

    function isOwnerOrParentCreate() {
      return emailVerified() && request.resource.data.parentId == request.auth.uid;
    }

    function isOwnerOrParentUpdate() {
      return emailVerified() && resource.data.parentId == request.auth.uid && request.resource.data.parentId == resource.data.parentId;
    }

    match /students/{studentId} {
      allow read: if isOwnerOrParent();
      allow create: if isOwnerOrParentCreate();
      allow update: if isOwnerOrParentUpdate();
      allow delete: if isOwnerOrParent();
    }

    match /grades/{gradeId} {
      allow read: if isOwnerOrParent() || isSchoolAdmin();
      allow create: if isOwnerOrParentCreate() || isSchoolAdmin();
      allow update: if (isOwnerOrParentUpdate() || isSchoolAdmin()) && request.resource.data.parentId == resource.data.parentId;
      allow delete: if isOwnerOrParent() || isSchoolAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isOwnerOrParent() || isSchoolAdmin();
      allow create: if isOwnerOrParentCreate() || isSchoolAdmin();
      allow update: if (isOwnerOrParentUpdate() || isSchoolAdmin()) && request.resource.data.parentId == resource.data.parentId;
      allow delete: if isOwnerOrParent() || isSchoolAdmin();
    }

    match /homeworks/{homeworkId} {
      allow read: if isOwnerOrParent() || isSchoolAdmin();
      allow create: if isOwnerOrParentCreate() || isSchoolAdmin();
      allow update: if (isOwnerOrParentUpdate() || isSchoolAdmin()) && request.resource.data.parentId == resource.data.parentId;
      allow delete: if isOwnerOrParent() || isSchoolAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isOwnerOrParent() || isSchoolAdmin();
      allow create: if isOwnerOrParentCreate() || isSchoolAdmin();
      allow update: if (isOwnerOrParentUpdate() || isSchoolAdmin()) && request.resource.data.parentId == resource.data.parentId;
      allow delete: if isOwnerOrParent() || isSchoolAdmin();
    }

    match /messages/{messageId} {
      allow read: if isOwnerOrParent() || isSchoolAdmin();
      allow create: if isOwnerOrParentCreate() || isSchoolAdmin();
      allow update: if (isOwnerOrParentUpdate() || isSchoolAdmin()) && request.resource.data.parentId == resource.data.parentId;
      allow delete: if isOwnerOrParent() || isSchoolAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isOwnerOrParent() || isSchoolAdmin();
      allow create: if isOwnerOrParentCreate() || isSchoolAdmin();
      allow update: if (isOwnerOrParentUpdate() || isSchoolAdmin()) && request.resource.data.parentId == resource.data.parentId;
      allow delete: if isOwnerOrParent() || isSchoolAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if emailVerified();
      allow create, update, delete: if false;
    }

    match /establishments/{establishmentId} {
      allow read: if emailVerified();
      allow create: if emailVerified() && (isSchoolAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow update: if emailVerified() && (isSchoolAdmin() || resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
      allow delete: if emailVerified() && (isSchoolAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /users/{email} {
      allow read: if emailVerified() && (isSelfUser(email) || isSchoolAdmin());
      allow create: if emailVerified() && isSelfUser(email);
      allow update: if emailVerified() && (isSelfUser(email) || isSchoolAdmin());
      allow delete: if emailVerified() && isSchoolAdmin();
    }

    match /super_admins/{email} {
      allow read: if emailVerified();
      allow create, update, delete: if emailVerified() && (isSchoolAdmin() || isSelfUser(email));
    }

    match /help_requests/{requestId} {
      allow read: if emailVerified() && (isSchoolAdmin() || resource.data.createdBy == request.auth.uid);
      allow create: if emailVerified();
      allow update, delete: if emailVerified() && isSchoolAdmin();
    }

    match /logs_auth/{logId} {
      allow create: if emailVerified() && request.resource.data.userId == request.auth.uid;
      allow read: if emailVerified() && isSchoolAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
