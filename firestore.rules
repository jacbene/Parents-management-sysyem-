rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.email == 'jacquesbene301@gmail.com') ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid)) ||
        (request.auth.token != null && exists(/databases/$(database)/documents/super_admins/$(request.auth.token.email)))
      );
    }

    // School Establishments
    match /establishments/{schoolId} {
      allow read, write: if true;
    }

    // Student Profiles
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Grades
    match /grades/{gradeId} {
      allow read, write: if true;
    }

    // Attendance Records
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Homework Assignments
    match /homeworks/{homeworkId} {
      allow read, write: if true;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Parent-Teacher Appointments
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Invoices & Financial Settings & System Audit Logs
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Classroom Lessons
    match /lessons/{lessonId} {
      allow read, write: if true;
    }

    // Library Reading Logs
    match /reading_logs/{logId} {
      allow read, write: if true;
    }

    // Academic Calendar Events
    match /academic_calendar/{eventId} {
      allow read, write: if true;
    }

    // Auth Logs (Audit Trail)
    match /logs_auth/{logId} {
      allow read, write: if true;
    }

    // Support Help Requests
    match /help_requests/{requestId} {
      allow read, write: if true;
    }

    // Roadmap & Feature Suggestions
    match /roadmap_suggestions/{suggestionId} {
      allow read, write: if true;
    }

    // Super Admin Directory
    match /super_admins/{adminId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Active User Sessions
    match /active_sessions/{sessionId} {
      allow read, write: if true;
    }

    // System Documents (e.g., deleted_schools)
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}

